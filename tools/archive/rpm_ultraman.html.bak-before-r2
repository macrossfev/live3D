<!DOCTYPE html><html><head><meta charset="utf-8">
<title>live3D · 头部样品台</title>
<style>body{margin:0;background:#0e1118;color:#dde;overflow:hidden}
#hud{position:fixed;top:8px;left:8px;font:12px/1.6 monospace;color:#7ef;white-space:pre;z-index:9}
#tip{position:fixed;bottom:8px;left:8px;font:12px monospace;color:#567}
#ref{position:fixed;top:8px;right:8px;border:1px solid #345;z-index:9}body.shooting #hud, body.shooting #tip, body.shooting #ref{display:none}
</style>
<script type="importmap">{"imports":{"three":"https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js","three/addons/":"https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/"}}</script>
</head><body><div id="hud">加载中…</div><div id="tip">拖动旋转 · 滚轮缩放</div>
<img id="ref" src="../assets/refs/classic.png" height="360" alt="参考立绘">
<script type="module">
import * as THREE from 'three';
import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
import { FBXLoader } from 'three/addons/loaders/FBXLoader.js';

const W = 620, H = 900;
const r = new THREE.WebGLRenderer({ antialias: true, preserveDrawingBuffer: true });
r.setSize(W, H); document.body.appendChild(r.domElement);
const s = new THREE.Scene();
s.background = new THREE.Color(.05, .055, .07);
const cam = new THREE.PerspectiveCamera(32, W / H, .1, 50);
s.add(new THREE.AmbientLight(0xffffff, .9));
const sun = new THREE.DirectionalLight(0xffffff, 2.6); sun.position.set(.5, 2.8, 5); s.add(sun);
const rim = new THREE.DirectionalLight(0x88bbff, .9); rim.position.set(-2, 2, -3); s.add(rim);
s.add(new THREE.GridHelper(4, 10));
const hud = document.getElementById('hud');
window.__stats = { stage: 'loading' };

let theta = .35, phi = 1.32, dist = 2.7;
r.domElement.addEventListener('pointermove', e => {
  if (e.buttons){ theta -= e.movementX * .01; phi = Math.min(1.5, Math.max(.7, phi - e.movementY * .008)); }
});
r.domElement.addEventListener('wheel', e => { dist = Math.min(6, Math.max(1.4, dist + e.deltaY * .002)); });
function placeCam(){
  cam.position.set(dist * Math.sin(phi) * Math.sin(theta), dist * Math.cos(phi) + .55, dist * Math.sin(phi) * Math.cos(theta));
  cam.lookAt(0, .95, 0);
}

// ============ 参考立绘画布 ============
const REF_W = 768, REF_H = 1360, CX = 386;
const refCv = document.createElement('canvas'); refCv.width = REF_W; refCv.height = REF_H;
const refCtx = refCv.getContext('2d', { willReadFrequently: true });
const refImg = new Image();
const refReady = new Promise(res => { refImg.onload = res; refImg.src = '../assets/refs/classic.png'; });
function sampleRef(x, h, Z2Y, SX){
  let y = Z2Y[Z2Y.length - 1][1];
  for (let i = 0; i < Z2Y.length - 1; i++){
    const [h0, y0] = Z2Y[i], [h1, y1] = Z2Y[i + 1];
    if (h <= h1){ y = y0 + (y1 - y0) * (h - h0) / Math.max(h1 - h0, 1e-6); break; }
  }
  const px = Math.round(CX + x * SX), py = Math.round(y);
  if (px < 0 || px >= REF_W || py < 0 || py >= REF_H) return null;
  const d = refCtx.getImageData(px, py, 1, 1).data;
  if (d[3] < 60) return null;
  return [d[0] / 255, d[1] / 255, d[2] / 255];
}
const SILVER = [.74, .77, .84], RED = [.78, .10, .12];
function backColor(x, h, bones){
  const a = Math.abs(x);
  if (h > bones.neckY) return h < bones.headY + .025 && a < .05 ? RED : SILVER;
  const rel = (h - bones.hipsY) / (bones.chestY - bones.hipsY);
  if (rel >= 0){
    const w = rel > .8 ? .125 : (rel > .45 ? .075 : .115);
    if (a < w * .5) return RED;
    if (rel > .75 && a < .16) return RED;
    return SILVER;
  }
  if (h > bones.kneeY) return a > .13 ? RED : SILVER;
  return SILVER;
}

let mixer = null;
const HEAD = new URLSearchParams(location.search).get('head') || 'a2';
const VIEWS = {
  front: [0, .95, 4.3], back: [0, .95, -4.3], left: [-4.3, .95, 0], right: [4.3, .95, 0],
  q34_left: [-3.0, 1.1, 3.0], q34_right: [3.0, 1.1, 3.0],
  top: [0, 4.0, .001], bottom: [0, -2.6, 3.0],
};
let frozen = false;
let __vcMat = null;
window.__freeze = () => {
  // Boxing t=0 是深度蹲伏（腿折进躯干高度带）——验收要站姿：
  // 停掉全部动作回到绑定姿势（RPM A-pose 站立）
  if (mixer){ mixer.stopAllAction(); mixer.update(0); }
  frozen = true; document.body.classList.add('shooting');
  // 实测：mixer.setTime/update 后早期材质失效——冻结时重建 vertexColors 材质再渲染
  if (window.__model){
    window.__model.traverse(o => {
      if (o.isSkinnedMesh && o.geometry.attributes.color){
        o.material = new THREE.MeshToonMaterial({ vertexColors: true });
      }
    });
  }
  r.render(s, cam);
  return 'frozen';
};
window.__setcam = v => {
  const p = VIEWS[v]; if (!p) return 'no view ' + v;
  cam.position.set(...p);
  cam.lookAt(0, v === 'top' ? 1.55 : .95, 0);
  r.render(s, cam);
  return 'cam=' + v;
};
window.__dbg = { get r(){ return r; }, get s(){ return s; }, get cam(){ return cam; }, get mixerM(){ return mixer; } };
window.__THREE = null;
async function main(){
  await refReady;
  refCtx.drawImage(refImg, 0, 0, REF_W, REF_H);

  const g = await new Promise((res, rej) => new GLTFLoader().load('../assets/rpm/avatar_full.glb', res, undefined, rej));
  const model = g.scene;
  s.add(model);
  model.updateMatrixWorld(true);

  // ---------- 网格识别：身体 / 头（RPM 中头是独立网格 Wolf3D_Head） ----------
  const meshes = [];
  model.traverse(o => { if (o.isSkinnedMesh) meshes.push(o); });
  const comp = (a, i, k) => a.isInterleavedBufferAttribute
    ? a.data.array[i * a.data.stride + a.offset + k] : a.getComponent(i, k);
  const dominant = o => {
    const si = o.geometry.attributes.skinIndex, sw = o.geometry.attributes.skinWeight;
    const bones = o.skeleton.bones, n = si.count;
    let head = 0;
    for (let i = 0; i < n; i++){
      let best = 0, bw = -1;
      for (let k = 0; k < 4; k++){ const w = comp(sw, i, k); if (w > bw){ bw = w; best = comp(si, i, k); } }
      if (/Head|Eye|Jaw|Teeth|Tongue/i.test(bones[best] ? bones[best].name : '')) head++;
    }
    return { ratio: head / n, n };
  };
  let body = null, headMesh = null;
  for (const m of meshes){
    const d = dominant(m);
    if (/Body/i.test(m.name) && d.ratio < .1) body = m;
    if (d.ratio > .5){ if (!headMesh || m.name.includes('Head')) headMesh = m; }
  }
  if (!body) body = meshes.sort((a, b) => b.geometry.attributes.position.count - a.geometry.attributes.position.count)[0];

  // ---------- 世界坐标（只统计被三角形引用的顶点，防孤立垃圾顶点） ----------
  // SkinnedMesh 原始顶点在绑定空间：世界位置 = Σ w_i·(boneWorld·boneInv)·bindMatrix·v，再乘 matrixWorld
  function worldOf(o){
    o.updateWorldMatrix(true, false);
    const g = o.geometry, p = g.attributes.position;
    const si = g.attributes.skinIndex, sw = g.attributes.skinWeight;
    const bones = o.skeleton.bones, invs = o.skeleton.boneInverses;
    const bm = o.bindMatrix, mw = o.matrixWorld;
    const out = new Float32Array(p.count * 3);
    const v = new THREE.Vector3(), t = new THREE.Vector3(), tmp = new THREE.Vector3();
    const M = new THREE.Matrix4();
    for (let i = 0; i < p.count; i++){
      v.fromBufferAttribute(p, i).applyMatrix4(bm);
      t.set(0, 0, 0);
      for (let k = 0; k < 4; k++){
        const w = comp(sw, i, k);
        if (!w) continue;
        const bi = comp(si, i, k);
        M.copy(bones[bi].matrixWorld).multiply(invs[bi]);
        tmp.copy(v).applyMatrix4(M).multiplyScalar(w);
        t.add(tmp);
      }
      t.applyMatrix4(mw);
      out[i*3] = t.x; out[i*3+1] = t.y; out[i*3+2] = t.z;
    }
    return out;
  }
  const vw = worldOf(body);
  const idx = body.geometry.index.array;
  const refd = new Set();
  for (let t = 0; t < idx.length; t++) refd.add(idx[t]);
  // GLB 里有孤立垃圾顶点（y=176 等）：只统计合理范围
  let hMin = 1e9, hMax = -1e9;
  for (const i of refd){
    const wy = vw[i*3+1], wx = vw[i*3];
    if (wy < 0 || wy > 2.2 || Math.abs(wx) > 1.2) continue;
    if (wy < hMin) hMin = wy; if (wy > hMax) hMax = wy;
  }

  // ---------- 骨骼锚点标定（世界 Y） ----------
  const B = n => model.getObjectByName(n);
  const bp = n => { const b = B(n); return b ? b.getWorldPosition(new THREE.Vector3()) : null; };
  const hips = bp('Hips'), spine2 = bp('Spine2'), neck = bp('Neck'), head = bp('Head');
  const shoulder = bp('LeftArm') || bp('LeftShoulder'), knee = bp('LeftLeg'), ankle = bp('LeftFoot');
  // 头顶：取头网格顶点最大 Y
  let headMaxY = hMax;
  if (headMesh){
    const hw = worldOf(headMesh);
    for (let i = 0; i < headMesh.geometry.attributes.position.count; i++)
      if (hw[i*3+1] > headMaxY && hw[i*3+1] < 2.2 && Math.abs(hw[i*3]) < 1.2) headMaxY = hw[i*3+1];
  }
  const bones = { hipsY: hips.y, chestY: spine2.y, neckY: neck.y, headY: head.y, kneeY: knee.y };
  const Z2Y = [[hMin, 1119], [ankle.y, 1019], [knee.y, 795], [hips.y, 591],
               [spine2.y, 472], [shoulder.y, 430], [neck.y, 361], [head.y, 336], [headMaxY, 268]];
  let pelvisHalf = 0;
  for (const i of refd){
    const wy = vw[i*3+1], wx = Math.abs(vw[i*3]);
    if (Math.abs(wy - hips.y) < .05 && wx > pelvisHalf && wx < .3) pelvisHalf = wx;
  }
  const SX = 165 / (2 * (pelvisHalf || .17));   // 立绘盆行 165px ↔ 人体盆宽

  // ---------- 身体上色：正面立绘投影 / 背面程序纹 ----------
  {
    // 逐顶点主骨名（手臂是 A-pose，立绘是 T-pose → 手臂只能骨权重配色）
    const bsi = body.geometry.attributes.skinIndex, bsw = body.geometry.attributes.skinWeight;
    const boneList = body.skeleton.bones;
    const domName = new Array(body.geometry.attributes.position.count).fill('');
    for (const i of refd){
      let best = 0, bw = -1;
      for (let k = 0; k < 4; k++){ const w = comp(bsw, i, k); if (w > bw){ bw = w; best = comp(bsi, i, k); } }
      domName[i] = boneList[best] ? boneList[best].name : '';
    }
    // 每高度带的世界 z 中心（正/背面判据，不用局部法线）
    const NB = 24, zSum = new Float32Array(NB), zCnt = new Float32Array(NB);
    for (const i of refd){
      const h = vw[i*3+1];
      const bI = Math.min(NB - 1, Math.max(0, Math.floor(h / 1.8 * NB)));
      zSum[bI] += vw[i*3+2]; zCnt[bI]++;
    }
    const zCenter = h => {
      const bI = Math.min(NB - 1, Math.max(0, Math.floor(h / 1.8 * NB)));
      return zCnt[bI] ? zSum[bI] / zCnt[bI] : 0;
    };
    const col = new Float32Array(body.geometry.attributes.position.count * 3);
    for (const i of refd){
      const bn = domName[i];
      const x = vw[i*3], h = vw[i*3+1], wz = vw[i*3+2];
      let c;
      if (/Shoulder|Clav|Arm(Twist)?$/i.test(bn)) c = RED;                 // 肩+上臂红
      else if (/ForeArm|Hand|Twitch|Twist/i.test(bn)) c = SILVER;         // 前臂+手银
      else if (wz > zCenter(h) - .015 && h < head.y - .01) c = sampleRef(x, h, Z2Y, SX);  // 正面
      if (!c) c = backColor(x, h, bones);
      col[i*3] = c[0]; col[i*3+1] = c[1]; col[i*3+2] = c[2];
    }
    body.geometry.setAttribute('color', new THREE.BufferAttribute(col, 3));
    body.material = new THREE.MeshToonMaterial({ vertexColors: true });
    body.frustumCulled = false;
  }

  // ---------- 头部方案（?head=a1|a2|none） ----------
  const headBone2 = B('Head');
  let headInfo = 'none';
  if (HEAD === 'a1' && headMesh){
    // A1 UV 重绘：UV 三角形填充分区色 + 眼睛椭圆，回贴保留人头几何
    headMesh.updateWorldMatrix(true, false);
    const hg = headMesh.geometry;
    const hw = worldOf(headMesh);
    const hIdx = hg.index.array;
    const uvA = hg.attributes.uv;
    const saneH = i => { const y = hw[i*3+1]; return y > 1.2 && y < 2.2 && Math.abs(hw[i*3]) < .4; };
    const A = 1024;
    const atlas = document.createElement('canvas'); atlas.width = A; atlas.height = A;
    const actx = atlas.getContext('2d');
    actx.fillStyle = '#c3c9d4'; actx.fillRect(0, 0, A, A);
    const zone = (x, y, z) => {
      if (z < head.z - .01 || Math.abs(x) > .072) return RED;
      if (y < head.y - .055) return RED;
      return SILVER;
    };
    const css = c => `rgb(${c.map(v => Math.round(v * 255)).join(',')})`;
    for (let t = 0; t < hIdx.length; t += 3){
      const a = hIdx[t], b2 = hIdx[t+1], c2 = hIdx[t+2];
      if (!(saneH(a) && saneH(b2) && saneH(c2))) continue;
      const cx = (hw[a*3] + hw[b2*3] + hw[c2*3]) / 3;
      const cy = (hw[a*3+1] + hw[b2*3+1] + hw[c2*3+1]) / 3;
      const cz = (hw[a*3+2] + hw[b2*3+2] + hw[c2*3+2]) / 3;
      actx.fillStyle = css(zone(cx, cy, cz));
      actx.beginPath();
      actx.moveTo(comp(uvA, a, 0) * A, (1 - comp(uvA, a, 1)) * A);
      actx.lineTo(comp(uvA, b2, 0) * A, (1 - comp(uvA, b2, 1)) * A);
      actx.lineTo(comp(uvA, c2, 0) * A, (1 - comp(uvA, c2, 1)) * A);
      actx.closePath(); actx.fill();
    }
    const eyeT = (336 - 310) / (336 - 268);
    const eyeH2 = head.y + (headMaxY - head.y) * eyeT;
    for (const sd of [-1, 1]){
      const tx = sd * .042, ty = eyeH2, tz = head.z + .09;
      let bestI = -1, bd = 1e9;
      for (let i = 0; i < hg.attributes.position.count; i++){
        if (!saneH(i)) continue;
        const dd = (hw[i*3]-tx)**2 + (hw[i*3+1]-ty)**2 + (hw[i*3+2]-tz)**2;
        if (dd < bd){ bd = dd; bestI = i; }
      }
      if (bestI < 0) continue;
      const u = comp(uvA, bestI, 0), v = comp(uvA, bestI, 1);
      actx.save();
      actx.translate(u * A, (1 - v) * A);
      actx.rotate(sd * .3);
      actx.fillStyle = '#fff6c0';
      actx.beginPath();
      actx.ellipse(0, 0, A * .035, A * .011, 0, 0, Math.PI * 2);
      actx.fill();
      actx.restore();
    }
    const tex = new THREE.CanvasTexture(atlas);
    tex.colorSpace = THREE.SRGBColorSpace;
    tex.flipY = false;
    headMesh.material = new THREE.MeshToonMaterial({ map: tex });
    headMesh.frustumCulled = false;
    headMesh.visible = true;
    headInfo = 'a1';
  } else if (HEAD === 'a2' && headBone2){
    if (headMesh) headMesh.visible = false;
    const glb = await new Promise((res, rej) => new GLTFLoader().load('../assets/output/helmet_a2.glb', res, undefined, rej));
    const helmet = glb.scene;
    const hw2 = worldOf(headMesh || body);
    let cy2 = head.y + .02, cz2 = .012, n2 = 0;
    if (headMesh){
      for (let i = 0; i < headMesh.geometry.attributes.position.count; i++){
        const y = hw2[i*3+1];
        if (y > 1.2 && y < 2.2 && Math.abs(hw2[i*3]) < .4){ cy2 += hw2[i*3+1]; cz2 += hw2[i*3+2]; n2++; }
      }
      if (n2){ cy2 /= (n2 + 1); cz2 /= (n2 + 1); }
    }
    const wp = new THREE.Vector3(0, cy2, cz2);
    headBone2.worldToLocal(wp);
    helmet.position.copy(wp);
    headBone2.add(helmet);
    headInfo = 'a2';
  } else {
    if (headMesh) headMesh.visible = false;
  }

  // ---------- 隐藏其余裸网格 ----------
  let hidden = 0;
  model.traverse(o => {
    if (o.isSkinnedMesh && o !== body && !(HEAD === 'a1' && o === headMesh)){ o.visible = false; hidden++; }
  });

  // ---------- 计时器（挂 Spine2 胸口） ----------
  const mSil = new THREE.MeshToonMaterial({ color: 0xbfd0de });
  const mDark = new THREE.MeshToonMaterial({ color: 0x23262e });
  const glow = c => new THREE.MeshBasicMaterial({ color: c });
  const spine2B = B('Spine2');
  if (spine2B){
    let chestFront = spine2.z;
    for (const i of refd)
      if (Math.abs(vw[i*3]) < .06 && Math.abs(vw[i*3+1] - spine2.y) < .12 && vw[i*3+2] > chestFront)
        chestFront = vw[i*3+2];
    const tGroup = new THREE.Group();
    tGroup.add(new THREE.Mesh(new THREE.TorusGeometry(.026, .008, 10, 20), mSil));
    const timer = new THREE.Mesh(new THREE.SphereGeometry(.023, 14, 12), glow(0x38a8ff));
    timer.position.z = .004; tGroup.add(timer);
    const wp = new THREE.Vector3(0, spine2.y + .02, chestFront + .002);
    spine2B.worldToLocal(wp); tGroup.position.copy(wp);
    spine2B.add(tGroup);
  }

  window.__model = model;
  window.__stats = { stage: 'rigged', head: headInfo, body: body.name,
                     hidden, SX: +SX.toFixed(0), headTop: +headMaxY.toFixed(2),
                     anchors: Z2Y.map(a => +a[0].toFixed(2)) };

  // ---------- Boxing 动画 ----------
  const fbx = await new Promise((res, rej) => new FBXLoader().load('../assets/samples/Boxing.fbx', res, undefined, rej));
  const clip = fbx.animations[0];
  const tracks = [];
  for (const tr of clip.tracks){
    const name = tr.name.replace(/^mixamorig:?/, '');
    if (tr.name.endsWith('.position')){
      const v = new Float32Array(tr.values.length);
      for (let i = 0; i < tr.values.length; i++) v[i] = tr.values[i] * .01;
      tracks.push(new THREE.VectorKeyframeTrack(name, tr.times, v));
    } else tracks.push(new THREE.QuaternionKeyframeTrack(name, tr.times, tr.values.slice()));
  }
  const clip2 = new THREE.AnimationClip('boxing', clip.duration, tracks);
  mixer = new THREE.AnimationMixer(model);
  mixer.clipAction(clip2).play();
  // 实测玄学：main() 早期创建的 vertexColors 材质不渲染（早期 shader 编译态坏了），
  // 全部资源加载完成后重建同款材质即恢复。原因未深究，勿在加载中途渲染。
  body.material = new THREE.MeshToonMaterial({ vertexColors: true });
  if (HEAD === 'a1' && headMesh) headMesh.material = new THREE.MeshToonMaterial({ map: headMesh.material.map });
  window.__stats.stage = 'animating';
  hud.textContent = `head=${headInfo} SX=${SX.toFixed(0)} 隐藏${hidden}\n空格冻结摆拍 · 拳击播放中`;
  document.title = 'OK';
}
window.__THREE = THREE;
main().catch(e => { hud.textContent = '失败 ' + (e.message || e); window.__stats = { stage: 'error', err: '' + e }; document.title = 'ERR'; });

window.__api = {
  pause(){ if (mixer) mixer.timeScale = 0; },
  cam(t, p, d){ theta = t; phi = p; dist = d; },
  snap(){ placeCam(); r.render(s, cam); return r.domElement.toDataURL(); }
};
const clock = new THREE.Clock();
(function loop(){
  requestAnimationFrame(loop);
  if (mixer && !frozen) mixer.update(clock.getDelta());
  if (!frozen) placeCam();          // 冻结摆拍时不得覆盖 __setcam 机位
  r.render(s, cam);
})();
</script></body></html>
